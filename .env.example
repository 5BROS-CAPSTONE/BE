# Spring Boot reads this file as Java properties after it is copied to .env.
spring.profiles.active=supabase

# Supabase Session Pooler (port 5432). Keep the database password out of the URL.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode\=require
SUPABASE_DB_USERNAME=postgres.<project-ref>
SUPABASE_DB_PASSWORD=

# Generate a Base64 secret in PowerShell (keep it private; share securely if instances share tokens):
# $b = New-Object byte[] 32
# $r = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $r.GetBytes($b); $r.Dispose(); [Convert]::ToBase64String($b)
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL=PT30M
AUTH_REFRESH_TOKEN_TTL=P30D

BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@5bros.local
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=5BROS Administrator

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
SERVER_PORT=8080
API_DOCS_ENABLED=true
